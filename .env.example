APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=telunas_issue_tracker
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail configuration (use smtp for real email sending or log for local testing)
# For Gmail / Google Workspace: MAIL_MAILER=smtp, MAIL_HOST=smtp.gmail.com, MAIL_PORT=587, MAIL_ENCRYPTION=tls
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@telunasresorts.com"
MAIL_FROM_NAME="Telunas Issue Tracker"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Google Sheets Configuration
GOOGLE_CREDENTIALS_PATH=app/google-credentials.json
GOOGLE_SPREADSHEET_ID=
GOOGLE_LEAN_SPREADSHEET_ID=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_SHEET_ISSUES_WEBHOOK_URL=
GOOGLE_SHEET_LOCATIONS_WEBHOOK_URL=

# WhatsApp Bot Security API Key
BOT_API_KEY=

# Web Push VAPID Keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@telunasresorts.com

# Telunas Wi-Fi Network Access Restriction (Disabled & optional for Cloud Hosting)
RESTRICT_TELUNAS_WIFI=false
TELUNAS_WIFI_IPS=auto
TELUNAS_WIFI_BYPASS_PASSCODE=
TELUNAS_WIFI_BYPASS_HOURS=24

# Cloud Proxy, HTTPS & Session Security
# Leave TRUSTED_PROXIES empty on direct VPS/Nginx. Set '*' or comma-separated CIDRs only behind Cloudflare/LB.
TRUSTED_PROXIES=
SESSION_SECURE_COOKIE=

# Cloud Authentication, WhatsApp OTP & Self-Registration Controls
LOGIN_OTP_ENABLED=true
# Set true once all login accounts have registered WhatsApp numbers:
LOGIN_OTP_REQUIRE_WHATSAPP=false
LOGIN_OTP_TTL_MINUTES=5
LOGIN_OTP_MAX_ATTEMPTS=5
LOGIN_OTP_RESEND_COOLDOWN_SECONDS=60
REGISTRATION_ENABLED=false


